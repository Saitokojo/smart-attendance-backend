{
  "info": {
    "_postman_id": "bbu-smart-attendance-week1",
    "name": "BBU Smart Attendance System - Week 1 (Auth API)",
    "description": "សំណុំតេស្ត RESTful API សប្តាហ៍ទី ១ សម្រាប់គម្រោងសារណា BBU IT (សាកលវិទ្យាល័យបៀលប្រាយ)\nប្រព័ន្ធគ្រប់គ្រងវត្តមានឆ្លាតវៃ - Authentication & Role-Based Access Control",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. ចុះឈ្មោះសិស្សថ្មី (Register Student)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Response success is true\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.role).to.eql('STUDENT');",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sril Mengty\",\n  \"email\": \"mengty@bbu.edu.kh\",\n  \"password\": \"password123\",\n  \"role\": \"STUDENT\",\n  \"studentCode\": \"BBU-STU-001\",\n  \"phone\": \"012345678\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Endpoint ចុះឈ្មោះគណនីសិស្សថ្មី។ Role ត្រូវតែជា STUDENT។"
      }
    },
    {
      "name": "02. ចុះឈ្មោះគ្រូថ្មី (Register Teacher)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test(\"Teacher registered successfully\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.role).to.eql('TEACHER');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Din Saren\",\n  \"email\": \"saren@bbu.edu.kh\",\n  \"password\": \"password123\",\n  \"role\": \"TEACHER\",\n  \"phone\": \"098765432\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "Endpoint ចុះឈ្មោះគណនីគ្រូបង្រៀន។ Role ត្រូវតែជា TEACHER។"
      }
    },
    {
      "name": "03. ចូលប្រើប្រាស់ជោគជ័យ (Login Success - Auto Save JWT)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Auto Save JWT Access Token to Collection Variable\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(true);",
              "    pm.expect(jsonData.data.accessToken).to.be.a('string');",
              "    pm.collectionVariables.set(\"jwt_token\", jsonData.data.accessToken);",
              "    console.log(\"Saved JWT Token:\", jsonData.data.accessToken);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mengty@bbu.edu.kh\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "Endpoint Login ដោយផ្ទៀងផ្ទាត់ Email & Password (BCrypt) និងឆ្លើយតបមកវិញនូវ JWT Bearer Token។"
      }
    },
    {
      "name": "04. ចូលប្រើប្រាស់បរាជ័យ (Login Fail - Bad Password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 401 Unauthorized\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"Response success is false with error message\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"mengty@bbu.edu.kh\",\n  \"password\": \"wrongpassword999\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "description": "តេស្តករណី Login ខុស Password ត្រូវឆ្លើយតប 401 Unauthorized។"
      }
    },
    {
      "name": "05. កំហុស Validation (Register Validation Error - Weak Password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test(\"Validation error data is returned\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.eql(false);",
              "    pm.expect(jsonData.data).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"email\": \"invalid-email-format\",\n  \"password\": \"123\",\n  \"role\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth/register",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "description": "តេស្តករណីទិន្នន័យមិនត្រឹមត្រូវ ត្រូវចាប់ដោយ GlobalExceptionHandler ឆ្លើយតប 400 Bad Request។"
      }
    }
  ]
}